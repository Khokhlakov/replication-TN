+def is_hydrogen(rec: dict) -> bool:
+    """True for H or D atoms. Uses the element columns (77-78) when filled, else the atom name."""
+    col = rec.get("element_col", "")
+    if col:
+        return col in ("H", "D")
+    return rec.get("name", "").strip().lstrip("0123456789").startswith(("H", "D"))
